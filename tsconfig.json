{
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "build"
    ],
    "compilerOptions": {
        "target": "es2017",
        "module": "esnext",
        "moduleResolution": "bundler",
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "lib": [
            "dom",
            "es2017"
        ],
        "outDir": "./build",
        "baseUrl": "",
        "paths": {
            "phaser": [ "node_modules/phaser/dist/phaser"]
        }
    }
}
